{
  "name": "chiang-pai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/gen-lingo.ts && next dev",
    "build": "node scripts/gen-lingo.ts && next build",
    "lingo:gen": "node scripts/gen-lingo.ts",
    "start": "next start",
    "lint": "biome check .",
    "postinstall": "if [ -f scripts/gen-lingo.ts ]; then node scripts/gen-lingo.ts; fi",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "recovery:link": "node --env-file-if-exists=.env scripts/recovery-link.ts",
    "prepare": "husky",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@11.22.0"
}
