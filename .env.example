# Copy to .env and fill in. All configuration is validated in lib/env.ts —
# that file is the single place environment variables are read.

# Postgres. Local dev default matches `docker compose up db`.
# DB_PORT is the host port the dev Postgres container maps to; keep the
# DATABASE_URL port in sync with it.
DB_PORT=5566
DATABASE_URL=postgres://chiangpai:chiangpai@127.0.0.1:5566/chiangpai

# HTTP. APP_PORT is the host port docker maps to; PORT drives `next dev`/
# `next start` directly when running without docker. APP_BIND is the host
# interface docker binds (default loopback — put a reverse proxy in front;
# set 0.0.0.0 to expose directly).
APP_PORT=3004
APP_BIND=127.0.0.1

# Postgres password used by docker compose (dev default: chiangpai).
# Set a strong one in production.
POSTGRES_PASSWORD=chiangpai

# Sessions are HMAC-signed with AUTH_SECRET; rotating it signs everyone out.
# Required — the server refuses to start without one (min 16 chars).
# Generate a real one: `openssl rand -base64 32`
# AUTH_URL is the public base URL (your domain in production, e.g.
# https://pai.example.com) — Google OAuth callbacks derive from it.
AUTH_SECRET=
# Public URL of the app. The Google redirect URI is built from it, and an
# https:// value is what marks the session cookie Secure.
# localhost, not 127.0.0.1: passkeys need a hostname — an IP address is not a
# valid relying party id, and no browser will register one against it.
AUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/apis/credentials).
# Authorised redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Local development only: passwordless fake login, bypasses the invite list.
# NEVER set to true in production.
AUTH_DEV_LOGIN=false

# Comma-separated emails that can always sign in, and are the only people who
# can invite others. Seed this with at least your own Gmail address.
FOUNDING_MEMBERS=you@example.com

# Logging (pino): fatal | error | warn | info | debug | trace | silent.
# Unset means info in production and debug in development.
# LOG_LEVEL=info

# Game configuration (pies). Members have an infinite bank — net can go negative.
MAX_STAKE_PIES=10
RANKED_MIN_RESOLVED=5

# Optional: LLM polish for market drafts, via any Anthropic-compatible API.
# For MiniMax M3: LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_BASE_URL=https://api.minimax.io/anthropic
LLM_API_KEY=
LLM_MODEL=MiniMax-M3
